---
import Icone from './Icone.astro';
interface Props { href: string; titre: string; texte: string; categorie: 'pdf' | 'image' | 'video'; }
const { href, titre, texte, categorie } = Astro.props;
---
<a class="carte-outil" href={href}>
  <span class={`pastille pastille-${categorie}`}><Icone nom={categorie} /></span>
  <span><strong>{titre}</strong><span>{texte}</span></span>
</a>
